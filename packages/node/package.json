{
  "name": "agentopt",
  "version": "0.0.2",
  "description": "Self-improving loop for your existing AI agent: write GOALS.md, agentopt measures the gap and closes it - prompts, params, and a learned playbook. No model training.",
  "keywords": [
    "ai",
    "agents",
    "evals",
    "optimization",
    "prompt-engineering",
    "self-improving",
    "mastra",
    "ai-sdk",
    "langgraph"
  ],
  "homepage": "https://github.com/vickykumar123/agentopt",
  "license": "MIT",
  "author": "Vicky Kumar",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "agentopt": "bin/agentopt.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.4",
    "deepagents": "^1.12.2",
    "ts-morph": "^27.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
